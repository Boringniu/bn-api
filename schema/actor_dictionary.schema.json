{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boringniu.example/schema/actor_dictionary.schema.json",
  "title": "Boringniu actor dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_version",
    "updated_at",
    "updated_by",
    "items",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "config_version": {
      "$ref": "#/$defs/semver"
    },
    "updated_at": {
      "$ref": "#/$defs/utcDateTime"
    },
    "updated_by": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_ai_translate_actor",
        "allow_ai_create_actor",
        "unknown_actor_action",
        "max_actors_per_video",
        "max_display_actors_per_video",
        "channel_display_field"
      ],
      "properties": {
        "allow_ai_translate_actor": {
          "const": false
        },
        "allow_ai_create_actor": {
          "const": false
        },
        "unknown_actor_action": {
          "const": "review"
        },
        "max_actors_per_video": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_display_actors_per_video": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "channel_display_field": {
          "const": "display_name_zh_cn"
        }
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "display_name_zh_cn",
        "name_ja",
        "name_en",
        "romanized_name",
        "status",
        "display_enabled",
        "search_enabled",
        "aliases",
        "notes",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^actor_[0-9]{6,}$"
        },
        "display_name_zh_cn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "name_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_en": {
          "type": [
            "string",
            "null"
          ]
        },
        "romanized_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "display_enabled": {
          "type": "boolean"
        },
        "search_enabled": {
          "type": "boolean"
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/actorAlias"
          }
        },
        "notes": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/utcDateTime"
        },
        "updated_at": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "actorAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "normalized_value",
        "language",
        "status",
        "source"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "normalized_value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "language": {
          "enum": [
            "zh-CN",
            "zh-TW",
            "ja",
            "en",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "approved",
            "pending",
            "deprecated",
            "disabled"
          ]
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "status": {
      "enum": [
        "approved",
        "pending",
        "ignored",
        "deprecated",
        "disabled"
      ]
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
