{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boringniu.example/schema/version.schema.json",
  "title": "Boringniu config version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_version",
    "updated_at",
    "updated_by",
    "items",
    "release",
    "compatibility",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "config_version": {
      "$ref": "#/$defs/semver"
    },
    "updated_at": {
      "$ref": "#/$defs/utcDateTime"
    },
    "updated_by": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "items": {
      "type": "array",
      "maxItems": 0
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "release_date",
        "description"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "release_date": {
          "type": "string",
          "format": "date"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_worker_version",
        "minimum_bot_version",
        "minimum_database_schema_version"
      ],
      "properties": {
        "minimum_worker_version": {
          "$ref": "#/$defs/semver"
        },
        "minimum_bot_version": {
          "$ref": "#/$defs/semver"
        },
        "minimum_database_schema_version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "tag_dictionary",
        "actor_dictionary",
        "alias",
        "ignored",
        "display",
        "search",
        "review_rules"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/semver"
        },
        "tag_dictionary": {
          "$ref": "#/$defs/semver"
        },
        "actor_dictionary": {
          "$ref": "#/$defs/semver"
        },
        "alias": {
          "$ref": "#/$defs/semver"
        },
        "ignored": {
          "$ref": "#/$defs/semver"
        },
        "display": {
          "$ref": "#/$defs/semver"
        },
        "search": {
          "$ref": "#/$defs/semver"
        },
        "review_rules": {
          "$ref": "#/$defs/semver"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
