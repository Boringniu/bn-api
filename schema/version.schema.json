{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boringniu.example/schema/version.schema.json",
  "title": "Boringniu config version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_version",
    "updated_at",
    "release"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "config_version": {
      "$ref": "#/$defs/semver"
    },
    "updated_at": {
      "$ref": "#/$defs/utcDateTime"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "release_date",
        "description"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "release_date": {
          "type": "string",
          "format": "date"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
