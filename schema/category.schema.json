{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boringniu.example/schema/category.schema.json",
  "title": "Boringniu category configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "updated_by",
    "items",
    "classification_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "updated_at": {
      "$ref": "#/$defs/utcDateTime"
    },
    "updated_by": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "classification_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_multiple_categories",
        "fallback_category",
        "on_no_match",
        "on_multiple_match",
        "store_all_candidates"
      ],
      "properties": {
        "allow_multiple_categories": {
          "const": false
        },
        "fallback_category": {
          "type": "null"
        },
        "on_no_match": {
          "const": "review"
        },
        "on_multiple_match": {
          "const": "use_highest_priority"
        },
        "store_all_candidates": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_id",
        "display_name",
        "slug",
        "status",
        "priority",
        "aliases",
        "normalized_aliases",
        "description",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "category_id": {
          "type": "string",
          "pattern": "^cat_[a-z0-9_]+$"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "aliases": {
          "$ref": "#/$defs/stringList"
        },
        "normalized_aliases": {
          "$ref": "#/$defs/stringList"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "created_at": {
          "$ref": "#/$defs/utcDateTime"
        },
        "updated_at": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "status": {
      "enum": [
        "approved",
        "pending",
        "ignored",
        "deprecated",
        "disabled"
      ]
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
