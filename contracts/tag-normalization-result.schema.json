{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boringniu.example/contracts/tag-normalization-result.schema.json",
  "title": "Boringniu tag normalization result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ruleset_version",
    "raw_tags",
    "selected_category",
    "category_candidates",
    "standard_tags",
    "display_tags",
    "ignored_tags",
    "reviews",
    "decisions",
    "violations"
  ],
  "properties": {
    "ruleset_version": {
      "$ref": "#/$defs/semver"
    },
    "raw_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "selected_category": {
      "oneOf": [
        {
          "$ref": "#/$defs/category"
        },
        {
          "type": "null"
        }
      ]
    },
    "category_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "standard_tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "display_tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "ignored_tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ignoredTag"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_id",
        "display_name",
        "slug",
        "priority",
        "matched_raw_values",
        "matched_input_indexes",
        "match_sources"
      ],
      "properties": {
        "category_id": {
          "type": "string",
          "pattern": "^cat_[a-z0-9_]+$"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "matched_raw_values": {
          "$ref": "#/$defs/uniqueStringList"
        },
        "matched_input_indexes": {
          "$ref": "#/$defs/uniqueIndexList"
        },
        "match_sources": {
          "$ref": "#/$defs/matchSourceList"
        }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_id",
        "display_name",
        "slug",
        "tag_group",
        "weight",
        "display_enabled",
        "search_enabled",
        "matched_raw_values",
        "matched_input_indexes",
        "match_sources"
      ],
      "properties": {
        "tag_id": {
          "type": "string",
          "pattern": "^tag_[a-z0-9_]+$"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "tag_group": {
          "enum": [
            "theme",
            "role",
            "scene",
            "format",
            "subtitle",
            "other"
          ]
        },
        "weight": {
          "type": "integer",
          "minimum": 0
        },
        "display_enabled": {
          "type": "boolean"
        },
        "search_enabled": {
          "type": "boolean"
        },
        "matched_raw_values": {
          "$ref": "#/$defs/uniqueStringList"
        },
        "matched_input_indexes": {
          "$ref": "#/$defs/uniqueIndexList"
        },
        "match_sources": {
          "$ref": "#/$defs/matchSourceList"
        }
      }
    },
    "ignoredTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_index",
        "raw_value",
        "normalized_value",
        "ignore_id",
        "reason"
      ],
      "properties": {
        "input_index": {
          "type": "integer",
          "minimum": 0
        },
        "raw_value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "normalized_value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ignore_id": {
          "type": "string",
          "pattern": "^ignore_[0-9]{6,}$"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_type",
        "status",
        "trigger",
        "subject_type",
        "raw_values",
        "normalized_values",
        "allow_ai_suggestion",
        "allow_auto_approve",
        "required_reviewer_role"
      ],
      "properties": {
        "review_type": {
          "enum": [
            "pending_tag",
            "pending_alias",
            "pending_category"
          ]
        },
        "status": {
          "const": "pending"
        },
        "trigger": {
          "enum": [
            "tag_not_found_in_dictionary",
            "alias_candidate_detected",
            "category_not_resolved"
          ]
        },
        "subject_type": {
          "enum": [
            "tag",
            "alias",
            "category"
          ]
        },
        "raw_values": {
          "$ref": "#/$defs/uniqueStringList"
        },
        "normalized_values": {
          "$ref": "#/$defs/uniqueStringList"
        },
        "allow_ai_suggestion": {
          "type": "boolean"
        },
        "allow_auto_approve": {
          "const": false
        },
        "required_reviewer_role": {
          "enum": [
            "editor",
            "admin"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_index",
        "raw_value",
        "normalized_value",
        "outcome",
        "reference_id",
        "display_name",
        "source",
        "review_type"
      ],
      "properties": {
        "input_index": {
          "type": "integer",
          "minimum": 0
        },
        "raw_value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "normalized_value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "outcome": {
          "enum": [
            "standard_tag",
            "category_candidate",
            "ignored",
            "pending_review"
          ]
        },
        "reference_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/matchSource"
            },
            {
              "const": "ignored"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "actual",
        "limit"
      ],
      "properties": {
        "code": {
          "const": "max_tags_per_video_exceeded"
        },
        "actual": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "matchSource": {
      "enum": [
        "tag_dictionary",
        "category_dictionary",
        "global_alias"
      ]
    },
    "matchSourceList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/matchSource"
      }
    },
    "uniqueStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "uniqueIndexList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
