{
  "name": "boringniu-media-config",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boringniu 影视库的唯一规则配置中心",
  "scripts": {
    "validate": "node scripts/validate-config.mjs",

    "check:aliases": "node scripts/check-duplicate-alias.mjs",
    "check:versions": "node scripts/check-version-monotonic.mjs",
    "test": "node --test",
    "normalize:tags": "node scripts/normalize-tags.mjs",
    "build:manifest": "node scripts/build-config-manifest.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create bn-media",
    "db:migrate:local": "wrangler d1 migrations apply bn-media --local",
    "db:migrate:remote": "wrangler d1 migrations apply bn-media --remote",
    "deploy": "wrangler deploy",
    "check": "npm run validate && npm run check:aliases && npm run check:versions && npm test && npm run build:manifest && npm run build:worker"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "wrangler": "4.112.0"
  }
}
